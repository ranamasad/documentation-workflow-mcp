{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs-contract://v3/scope.schema.json",
  "title": "Exact encryption scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["projectId", "environment", "keyId"],
  "properties": {
    "projectId": {"$ref": "#/$defs/uuid"},
    "environment": {"enum": ["development", "beta", "production"]},
    "keyId": {"$ref": "#/$defs/uuid"}
  },
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$", "minLength": 36, "maxLength": 36}
  }
}
